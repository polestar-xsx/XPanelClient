<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyName>XPanelClient</AssemblyName>
    <RootNamespace>XPanel.Application</RootNamespace>
    <StartupObject>XPanel.Application.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XPanel.Core\XPanel.Core.csproj" />
    <ProjectReference Include="..\XPanel.Communication.Serial\XPanel.Communication.Serial.csproj" />
    <ProjectReference Include="..\XPanel.Communication.Bluetooth\XPanel.Communication.Bluetooth.csproj" />
    <ProjectReference Include="..\XPanel.Communication.MQTT\XPanel.Communication.MQTT.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MVVM Toolkit -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" />
    <!-- Logging Framework -->
    <PackageReference Include="Serilog" Version="3.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <!-- Windows Forms (System Tray) -->
    <PackageReference Include="System.Windows.Forms" Version="4.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Placeholder thumbnail for clock background modes (replace with real images later) -->
    <Resource Include="..\..\resources\Icon.png">
      <Link>Resources\Icon.png</Link>
    </Resource>
    <Resource Include="..\..\resources\Teams.png">
      <Link>Resources\ClockModePlaceholder.png</Link>
    </Resource>
    <Resource Include="..\..\resources\camera.png">
      <Link>Resources\camera.png</Link>
    </Resource>
    <!-- Clock background mode thumbnails -->
    <Resource Include="..\..\resources\Matrix.png">
      <Link>Resources\Matrix.png</Link>
    </Resource>
    <Resource Include="..\..\resources\GravityBall.png">
      <Link>Resources\GravityBall.png</Link>
    </Resource>
    <Resource Include="..\..\resources\Music.png">
      <Link>Resources\Music.png</Link>
    </Resource>
    <Resource Include="..\..\resources\dropper.png">
      <Link>Resources\dropper.png</Link>
    </Resource>
  </ItemGroup>

  <!-- 输出配置 -->
  <PropertyGroup>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>

</Project>
