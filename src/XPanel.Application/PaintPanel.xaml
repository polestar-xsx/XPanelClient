<UserControl x:Class="XPanel.Application.PaintPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XPanel.Application"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="PaintToolButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#9E9E9E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText" Text="Not synchronized · press Start to mirror on the device"
                           Foreground="#555" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Border x:Name="PreviewArea"
                        Width="320" Height="320"
                        Background="#0A0A0A"
                        CornerRadius="8"
                        ClipToBounds="True"
                        Cursor="Cross"
                        MouseWheel="PreviewArea_MouseWheel"
                        MouseRightButtonDown="PreviewArea_MouseRightButtonDown"
                        MouseRightButtonUp="PreviewArea_MouseRightButtonUp"
                        MouseLeftButtonDown="PreviewArea_MouseLeftButtonDown"
                        MouseMove="PreviewArea_MouseMove"
                        MouseLeftButtonUp="PreviewArea_MouseLeftButtonUp">
                    <local:LedMatrixDisplay x:Name="PreviewMatrix"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                </Border>

                <StackPanel Margin="15,0,0,0" VerticalAlignment="Top" Width="184">
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Palette" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>
                        <Border x:Name="EyedropperButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="30" Height="30" CornerRadius="6" Background="Transparent"
                                BorderBrush="#CCCCCC" BorderThickness="1" Cursor="Hand"
                                ToolTip="Eyedropper: click a pixel to pick its color"
                                MouseLeftButtonDown="Eyedropper_Click">
                            <Image Source="pack://application:,,,/Resources/dropper.png" Width="18" Height="18" Stretch="Uniform"/>
                        </Border>
                    </Grid>
                    <WrapPanel x:Name="BasicColorPanel" Width="184"/>
                    <TextBlock Text="Custom" FontWeight="Bold" Foreground="#333" Margin="0,14,0,8"/>
                    <WrapPanel x:Name="CustomColorPanel" Width="184"/>

                    <Grid Margin="0,18,0,0" Width="184">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Shape" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                            <RadioButton x:Name="RoundBrushRadio" Content="Round" GroupName="PaintBrushShape"
                                         IsChecked="True" Foreground="#333" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <RadioButton x:Name="SquareBrushRadio" Content="Square" GroupName="PaintBrushShape"
                                         Foreground="#333" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,12,0,0" Width="184">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Brush" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="BrushSizeSlider" Minimum="1" Maximum="8" Value="1"
                                IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                Margin="8,0" ValueChanged="BrushSizeSlider_ValueChanged"/>
                        <TextBlock Grid.Column="2" x:Name="BrushSizeText" Text="1" Foreground="#333"
                                   VerticalAlignment="Center" MinWidth="14" TextAlignment="Right"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button x:Name="UndoButton" Width="48" Height="34" Padding="4"
                                Style="{StaticResource PaintToolButtonStyle}" Background="#607D8B" Margin="0,0,8,0"
                                IsEnabled="False" ToolTip="Undo" Click="Undo_Click">
                            <Path Width="20" Height="20" Stretch="Uniform" Fill="White"
                                  Data="M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z"/>
                        </Button>
                        <Button x:Name="RedoButton" Width="48" Height="34" Padding="4"
                                Style="{StaticResource PaintToolButtonStyle}" Background="#607D8B"
                                IsEnabled="False" ToolTip="Redo" Click="Redo_Click">
                            <Path Width="20" Height="20" Stretch="Uniform" Fill="White"
                                  Data="M18.4 10.6C16.55 8.99 14.15 8 11.5 8c-4.65 0-8.58 3.03-9.96 7.22L3.9 16c1.05-3.19 4.05-5.5 7.6-5.5 1.95 0 3.73.72 5.12 1.88L13 16h9V7l-3.6 3.6z"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="HintText"
                       Text="Click or drag on the matrix to paint"
                       Foreground="#999" FontSize="11" TextAlignment="Center"
                       Margin="0,10,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                <Button x:Name="StartButton" Content="Start" Width="120" Padding="20,10" FontSize="13"
                        Style="{StaticResource PaintToolButtonStyle}" Background="#4CAF50" Margin="0,0,10,0"
                        ToolTip="Start or stop mirroring this canvas on the selected device" Click="Start_Click"/>
                <Button x:Name="LoadPictureButton" Content="Load Picture" Width="120" Padding="20,10" FontSize="13"
                        Style="{StaticResource PaintToolButtonStyle}" Background="#2196F3" Margin="0,0,10,0"
                        Click="LoadPicture_Click"/>
                <Button x:Name="ClearButton" Content="Clear" Width="120" Padding="20,10" FontSize="13"
                        Style="{StaticResource PaintToolButtonStyle}" Background="#FF9800" Margin="0,0,10,0"
                        Click="Clear_Click"/>
                <Button x:Name="SavePictureButton" Content="Save Picture" Width="120" Padding="20,10" FontSize="13"
                        Style="{StaticResource PaintToolButtonStyle}" Background="#607D8B"
                        ToolTip="Save the canvas as a PNG file on this computer" Click="SavePicture_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>