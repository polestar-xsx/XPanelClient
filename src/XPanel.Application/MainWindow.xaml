<Window x:Class="XPanel.Application.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XPanel Device Client" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Visibility="Hidden"
        Background="#F8F9FA">
    <Window.Resources>
        <!-- TabItem 样式 -->
        <Style x:Key="ModernTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Grid Height="30" Background="Transparent" Margin="12,4">
                            <Border Name="Border" 
                                    Height="30"
                                    Background="#FFFFFF"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="0"
                                    CornerRadius="10"
                                    Padding="25,0"
                                    Margin="0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <ContentPresenter x:Name="ContentSite"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2196F3"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="0"/>
                                <Setter TargetName="ContentSite" Property="TextBlock.Foreground" Value="White"/>
                                <Setter TargetName="ContentSite" Property="TextBlock.FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="Transparent"/>
                                <Setter TargetName="ContentSite" Property="TextBlock.Foreground" Value="#666666"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="Transparent"/>
                                <Setter TargetName="ContentSite" Property="TextBlock.Foreground" Value="#2196F3"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Rounded rectangle ComboBox style -->
        <Style x:Key="RoundedRectComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Display area for selected item -->
                            <Border Grid.Column="0"
                                   Background="{TemplateBinding Background}"
                                   BorderBrush="{TemplateBinding BorderBrush}"
                                   BorderThickness="{TemplateBinding BorderThickness}"
                                   CornerRadius="8,0,0,8"
                                   Padding="10,8">
                                <ContentPresenter x:Name="ContentPresenter"
                                                 Content="{TemplateBinding SelectionBoxItem}"
                                                 ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                 VerticalAlignment="Center"/>
                            </Border>

                            <!-- Toggle button for dropdown -->
                            <ToggleButton Grid.Column="1"
                                         Name="ToggleButton"
                                         Focusable="False"
                                         IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                         ClickMode="Press"
                                         Background="{TemplateBinding Background}"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         BorderThickness="0,1,1,1"
                                         Padding="5">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="Border"
                                               Background="{TemplateBinding Background}"
                                               BorderBrush="{TemplateBinding BorderBrush}"
                                               BorderThickness="{TemplateBinding BorderThickness}"
                                               CornerRadius="0,8,8,0">
                                            <Path Fill="#666666"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Data="M 0 0 L 4 4 L 8 0 Z"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#F5F5F5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Popup for dropdown items -->
                            <Popup Name="Popup"
                                  Placement="Bottom"
                                  IsOpen="{TemplateBinding IsDropDownOpen}"
                                  AllowsTransparency="True"
                                  Focusable="False"
                                  PopupAnimation="Fade">
                                <Border x:Name="DropDownBorder"
                                       Background="#FFFFFF"
                                       BorderBrush="#E0E0E0"
                                       BorderThickness="1"
                                       CornerRadius="8"
                                       Margin="0,2,0,0">
                                    <ScrollViewer SnapsToDevicePixels="True" MaxHeight="200">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#999999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Button Style for Sync Items -->
        <Style x:Key="ToggleSwitchStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="SwitchBorder" 
                                Background="#E0E0E0" 
                                CornerRadius="12" 
                                Width="50" 
                                Height="24"
                                BorderThickness="0">
                            <Canvas>
                                <Ellipse x:Name="SwitchCircle" 
                                         Width="20" 
                                         Height="20" 
                                         Fill="White" 
                                         Canvas.Top="2" 
                                         Canvas.Left="2"/>
                            </Canvas>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchBorder" Property="Background" Value="#4CAF50"/>
                                <Setter TargetName="SwitchCircle" Property="Canvas.Left" Value="28"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Rounded rectangle button style -->
        <Style x:Key="RoundedRectButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="#2196F3">
            <StackPanel Margin="20,15">
                <TextBlock Text="XPanel Device Client" FontSize="20" Foreground="White" FontWeight="Bold"/>
                <TextBlock Text="System Tray Application | Multi-Channel Support" FontSize="12" Foreground="#E0E0E0" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content Area with Left Sidebar Tabs -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Panel -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TabControl Name="LeftTabControl" TabStripPlacement="Left" 
                                Background="Transparent"
                                BorderThickness="0">
                        <TabItem Header="Device" Style="{StaticResource ModernTabItemStyle}">
                            <Grid/>
                        </TabItem>
                        <TabItem Header="Synchronization" Style="{StaticResource ModernTabItemStyle}">
                            <Grid/>
                        </TabItem>
                        <TabItem Header="Clock Style" Style="{StaticResource ModernTabItemStyle}">
                            <Grid/>
                        </TabItem>
                        <TabItem Header="System Settings" Style="{StaticResource ModernTabItemStyle}">
                            <Grid/>
                        </TabItem>
                    </TabControl>
                </ScrollViewer>
            </Border>

            <!-- Content Panel -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Tab Content Header -->
                <Border Grid.Row="0" Background="#FAFAFA" Padding="20,15" BorderBrush="#E0E0E0" BorderThickness="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Name="TabHeader" Text="Device Information" FontSize="18" FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center"/>
                        
                        <!-- Device Selector for Synchronization Page -->
                        <StackPanel Grid.Column="1" Name="DeviceSelectorPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,20,0">
                            <TextBlock Text="Select Device:" FontSize="14" Foreground="#333333" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Name="DeviceSelector" Style="{StaticResource RoundedRectComboBoxStyle}" Width="200" Height="32" Padding="10,6" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tab Content -->
                <Grid Grid.Row="1" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Device Info Tab Content -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Name="DeviceInfoPanel" Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Title -->
                            <TextBlock Grid.Row="0" Text="Connected Devices" FontSize="14" FontWeight="Bold" Margin="0,0,0,15" Visibility="Collapsed"/>

                            <!-- Connected Device Cards -->
                            <Grid Grid.Row="1">
                                <TextBlock Name="NoConnectedDevicesText" Text="No devices connected" Foreground="#999" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Name="ConnectedDevicesPanel" Visibility="Collapsed"/>
                                </ScrollViewer>
                            </Grid>

                        </Grid>
                    </StackPanel>

                    <!-- Synchronization Panel -->
                    <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Name="SyncPanel" Margin="0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Name="SyncItemsPanel" Margin="0"/>
                        </ScrollViewer>

                        <!-- Screenshot Request Button -->
                        <Button Grid.Row="1" Name="RequestScreenshotButton"
                                Style="{StaticResource RoundedRectButtonStyle}"
                            HorizontalAlignment="Center" Margin="0,15,0,0" Padding="14,8" Background="#4CAF50"
                                ToolTip="Request a screenshot from the device"
                                Click="RequestScreenshot_Click">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="pack://application:,,,/Resources/camera.png"
                                       Width="24" Height="24" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="Request Screenshot" VerticalAlignment="Center"
                                           Margin="8,0,0,0" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Settings Panel -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Name="SettingsPanel" Margin="0" Visibility="Collapsed">
                        <TextBlock Text="System Settings" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,15">
                            <StackPanel Margin="15">
                                <StackPanel Margin="0,0,0,15">
                                    <TextBlock Text="Communication Method:" FontWeight="Bold" Foreground="#333"/>
                                    <ComboBox Margin="0,8,0,0" Padding="10,8">
                                        <ComboBoxItem>COM Serial Port</ComboBoxItem>
                                        <ComboBoxItem>Bluetooth (BLE)</ComboBoxItem>
                                        <ComboBoxItem>Bluetooth (Classic)</ComboBoxItem>
                                        <ComboBoxItem>MQTT Ethernet</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,15">
                                    <TextBlock Text="Baud Rate:" FontWeight="Bold" Foreground="#333"/>
                                    <ComboBox Margin="0,8,0,0" Padding="10,8">
                                        <ComboBoxItem>9600</ComboBoxItem>
                                        <ComboBoxItem>19200</ComboBoxItem>
                                        <ComboBoxItem>115200</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel>
                                    <CheckBox Content="Auto-connect on startup" Margin="0,5,0,5"/>
                                    <CheckBox Content="Enable logging" Margin="0,5,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Clock Style Panel -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Name="ClockStylePanel" Margin="0" Visibility="Collapsed">
                        <TextBlock Text="Font" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,20">
                            <StackPanel Margin="15">
                                <!-- Font Bold -->
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Bold Font" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>
                                    <ToggleButton Grid.Column="1" Name="ClockBoldToggle" Style="{StaticResource ToggleSwitchStyle}"/>
                                </Grid>

                                <!-- Font Color -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Font Color" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Name="ClockFontColorSwatch" Width="28" Height="28" CornerRadius="6"
                                                Background="#FFFFFF" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,10,0"/>
                                        <Button Name="ClockFontColorButton" Content="Pick Color"
                                                Style="{StaticResource RoundedRectButtonStyle}" Padding="16,8" FontSize="12"
                                                Click="ClockFontColor_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Background -->
                        <TextBlock Text="Background" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,15">
                            <StackPanel Margin="15">
                                <TextBlock Text="Background Mode" FontWeight="Bold" Foreground="#333" Margin="0,0,0,12"/>
                                <WrapPanel Name="ClockBackgroundModePanel" Orientation="Horizontal">
                                    <!-- Matrix -->
                                    <Border Name="ClockModeMatrix" Tag="Matrix" Width="150" Margin="0,0,15,0"
                                            BorderBrush="#E0E0E0" BorderThickness="2" CornerRadius="8" Cursor="Hand"
                                            MouseLeftButtonUp="ClockBackgroundMode_Click">
                                        <StackPanel Margin="8">
                                            <Image Source="pack://application:,,,/Resources/ClockModePlaceholder.png"
                                                   Height="90" Stretch="Uniform"/>
                                            <TextBlock Text="Matrix" HorizontalAlignment="Center" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="#333" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- GravityBall -->
                                    <Border Name="ClockModeGravityBall" Tag="GravityBall" Width="150" Margin="0,0,15,0"
                                            BorderBrush="#E0E0E0" BorderThickness="2" CornerRadius="8" Cursor="Hand"
                                            MouseLeftButtonUp="ClockBackgroundMode_Click">
                                        <StackPanel Margin="8">
                                            <Image Source="pack://application:,,,/Resources/ClockModePlaceholder.png"
                                                   Height="90" Stretch="Uniform"/>
                                            <TextBlock Text="GravityBall" HorizontalAlignment="Center" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="#333" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Music -->
                                    <Border Name="ClockModeMusic" Tag="Music" Width="150" Margin="0,0,15,0"
                                            BorderBrush="#E0E0E0" BorderThickness="2" CornerRadius="8" Cursor="Hand"
                                            MouseLeftButtonUp="ClockBackgroundMode_Click">
                                        <StackPanel Margin="8">
                                            <Image Source="pack://application:,,,/Resources/ClockModePlaceholder.png"
                                                   Height="90" Stretch="Uniform"/>
                                            <TextBlock Text="Music" HorizontalAlignment="Center" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="#333" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Add Device Button (Bottom Center of whole Device area) -->
                    <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Name="AddDeviceBottomButton" Content="Add Device"
                              Style="{StaticResource RoundedRectButtonStyle}" Padding="20,12" Background="#4CAF50"
                              FontSize="12" Margin="0,15,0,0" Width="200" HorizontalAlignment="Center"
                           Click="AddDevice_Click"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid Margin="20,12">
                <TextBlock Name="NoDeviceStatusText"
                           Text="No Device"
                           Foreground="#666"
                           FontSize="12"
                           VerticalAlignment="Center"/>
                <StackPanel Name="DeviceStatusGroupPanel"
                            Orientation="Horizontal"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
