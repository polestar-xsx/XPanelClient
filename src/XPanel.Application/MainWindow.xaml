<Window x:Class="XPanel.Application.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XPanel Device Client" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Visibility="Hidden"
        Background="#F8F9FA">
    <Window.Resources>
        <!-- TabItem 样式 -->
        <Style x:Key="ModernTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Grid Height="50" Background="Transparent" Margin="12,4">
                            <Border Name="Border" 
                                    Background="#FFFFFF"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="0"
                                    CornerRadius="10"
                                    Padding="25,0"
                                    Margin="0"
                                    HorizontalAlignment="Stretch">
                                <ContentPresenter x:Name="ContentSite"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2196F3"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="0"/>
                                <Setter TargetName="ContentSite" Property="TextBlock.Foreground" Value="White"/>
                                <Setter TargetName="ContentSite" Property="TextBlock.FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="Transparent"/>
                                <Setter TargetName="ContentSite" Property="TextBlock.Foreground" Value="#666666"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="Transparent"/>
                                <Setter TargetName="ContentSite" Property="TextBlock.Foreground" Value="#2196F3"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <!-- Rounded rectangle button style -->
        <Style x:Key="RoundedRectButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="#2196F3">
            <StackPanel Margin="20,15">
                <TextBlock Text="XPanel Device Client" FontSize="20" Foreground="White" FontWeight="Bold"/>
                <TextBlock Text="System Tray Application | Multi-Channel Support" FontSize="12" Foreground="#E0E0E0" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content Area with Left Sidebar Tabs -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Panel -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TabControl Name="LeftTabControl" TabStripPlacement="Left" 
                                Background="Transparent"
                                BorderThickness="0">
                        <TabItem Header="Device" Style="{StaticResource ModernTabItemStyle}">
                            <Grid/>
                        </TabItem>
                        <TabItem Header="Device Control" Style="{StaticResource ModernTabItemStyle}">
                            <Grid/>
                        </TabItem>
                        <TabItem Header="System Settings" Style="{StaticResource ModernTabItemStyle}">
                            <Grid/>
                        </TabItem>
                    </TabControl>
                </ScrollViewer>
            </Border>

            <!-- Content Panel -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Tab Content Header -->
                <Border Grid.Row="0" Background="#FAFAFA" Padding="20,15" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                    <TextBlock Name="TabHeader" Text="Device Information" FontSize="18" FontWeight="Bold" Foreground="#333333"/>
                </Border>

                <!-- Tab Content -->
                <Grid Grid.Row="1" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Device Info Tab Content -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Name="DeviceInfoPanel" Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Title -->
                            <TextBlock Grid.Row="0" Text="Connected Devices" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>

                            <!-- Connected Device Cards -->
                            <Grid Grid.Row="1">
                                <TextBlock Name="NoConnectedDevicesText" Text="No devices connected" Foreground="#999" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Name="ConnectedDevicesPanel" Visibility="Collapsed"/>
                                </ScrollViewer>
                            </Grid>

                        </Grid>
                    </StackPanel>

                    <!-- Control Panel -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Name="ControlPanel" Margin="10,0,0,0">
                        <TextBlock Text="Quick Actions" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>
                        <Button Content="Connect Device" Padding="15,10" Background="#2196F3" Foreground="White" 
                               FontSize="12" Cursor="Hand" Margin="0,0,0,10"/>
                        <Button Content="Disconnect" Padding="15,10" Background="#FF9800" Foreground="White" 
                               FontSize="12" Cursor="Hand" Margin="0,0,0,10"/>
                        <Button Content="Refresh Status" Padding="15,10" Background="#4CAF50" Foreground="White" 
                               FontSize="12" Cursor="Hand"/>
                    </StackPanel>

                    <!-- Settings Panel -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Name="SettingsPanel" Margin="0" Visibility="Collapsed">
                        <TextBlock Text="System Settings" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,15">
                            <StackPanel Margin="15">
                                <StackPanel Margin="0,0,0,15">
                                    <TextBlock Text="Communication Method:" FontWeight="Bold" Foreground="#333"/>
                                    <ComboBox Margin="0,8,0,0" Padding="10,8">
                                        <ComboBoxItem>COM Serial Port</ComboBoxItem>
                                        <ComboBoxItem>Bluetooth (BLE)</ComboBoxItem>
                                        <ComboBoxItem>Bluetooth (Classic)</ComboBoxItem>
                                        <ComboBoxItem>MQTT Ethernet</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,15">
                                    <TextBlock Text="Baud Rate:" FontWeight="Bold" Foreground="#333"/>
                                    <ComboBox Margin="0,8,0,0" Padding="10,8">
                                        <ComboBoxItem>9600</ComboBoxItem>
                                        <ComboBoxItem>19200</ComboBoxItem>
                                        <ComboBoxItem>115200</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel>
                                    <CheckBox Content="Auto-connect on startup" Margin="0,5,0,5"/>
                                    <CheckBox Content="Enable logging" Margin="0,5,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Add Device Button (Bottom Center of whole Device area) -->
                    <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Name="AddDeviceBottomButton" Content="Add Device"
                              Style="{StaticResource RoundedRectButtonStyle}" Padding="20,12" Background="#4CAF50"
                              FontSize="12" Margin="0,15,0,0" Width="200" HorizontalAlignment="Center"
                           Click="AddDevice_Click"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid Margin="20,12">
                <TextBlock Name="NoDeviceStatusText"
                           Text="No Device"
                           Foreground="#666"
                           FontSize="12"
                           VerticalAlignment="Center"/>
                <StackPanel Name="DeviceStatusGroupPanel"
                            Orientation="Horizontal"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
