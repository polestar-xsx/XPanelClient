<Window x:Class="XPanel.Application.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XPanel Device Client" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Visibility="Hidden"
        Background="#F8F9FA">
    <Window.Resources>
        <!-- TabItem 样式：选中项与下方内容区背景融合，靠高亮/凸起区分，而非加选中框 -->
        <Style x:Key="ModernTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border Name="Border"
                                Height="33"
                                Background="{TemplateBinding Background}"
                            CornerRadius="10,10,0,0"
                                Padding="12,0"
                            Margin="4,6,4,-1"
                                VerticalAlignment="Bottom">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Height" Value="46"/>
                                <Setter TargetName="Border" Property="Margin" Value="4,0,4,-1"/>
                                <Setter TargetName="ContentSite" Property="TextBlock.Foreground" Value="#3F4D56"/>
                                <Setter TargetName="ContentSite" Property="TextBlock.FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="ContentSite" Property="TextBlock.Foreground" Value="#56616A"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ContentSite" Property="TextBlock.Foreground" Value="#805A45"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="HeaderOnlyTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <TabPanel IsItemsHost="True"
                                  Background="{TemplateBinding Background}"
                                  KeyboardNavigation.TabNavigation="Local"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded rectangle ComboBox style -->
        <Style x:Key="RoundedRectComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Display area for selected item -->
                            <Border Grid.Column="0"
                                   Background="{TemplateBinding Background}"
                                   BorderBrush="{TemplateBinding BorderBrush}"
                                   BorderThickness="{TemplateBinding BorderThickness}"
                                   CornerRadius="8,0,0,8"
                                   Padding="10,8">
                                <ContentPresenter x:Name="ContentPresenter"
                                                 Content="{TemplateBinding SelectionBoxItem}"
                                                 ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                 VerticalAlignment="Center"/>
                            </Border>

                            <!-- Toggle button for dropdown -->
                            <ToggleButton Grid.Column="1"
                                         Name="ToggleButton"
                                         Focusable="False"
                                         IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                         ClickMode="Press"
                                         Background="{TemplateBinding Background}"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         BorderThickness="0,1,1,1"
                                         Padding="5">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="Border"
                                               Background="{TemplateBinding Background}"
                                               BorderBrush="{TemplateBinding BorderBrush}"
                                               BorderThickness="{TemplateBinding BorderThickness}"
                                               CornerRadius="0,8,8,0">
                                            <Path Fill="#666666"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Data="M 0 0 L 4 4 L 8 0 Z"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#F5F5F5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Popup for dropdown items -->
                            <Popup Name="Popup"
                                  Placement="Bottom"
                                  IsOpen="{TemplateBinding IsDropDownOpen}"
                                  AllowsTransparency="True"
                                  Focusable="False"
                                  PopupAnimation="Fade">
                                <Border x:Name="DropDownBorder"
                                       Background="#FFFFFF"
                                       BorderBrush="#E0E0E0"
                                       BorderThickness="1"
                                       CornerRadius="8"
                                       Margin="0,2,0,0">
                                    <ScrollViewer SnapsToDevicePixels="True" MaxHeight="200">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#999999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Button Style for Sync Items -->
        <Style x:Key="ToggleSwitchStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="SwitchBorder" 
                                Background="#E0E0E0" 
                                CornerRadius="12" 
                                Width="50" 
                                Height="24"
                                BorderThickness="0">
                            <Canvas>
                                <Ellipse x:Name="SwitchCircle" 
                                         Width="20" 
                                         Height="20" 
                                         Fill="White" 
                                         Canvas.Top="2" 
                                         Canvas.Left="2"/>
                            </Canvas>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchBorder" Property="Background" Value="#4CAF50"/>
                                <Setter TargetName="SwitchCircle" Property="Canvas.Left" Value="28"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Rounded rectangle button style -->
        <Style x:Key="RoundedRectButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Content Area: Top Tab Strip + Left Device List + Right Content -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="175"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Device List Panel (full height, independent from the right-side tabs) -->
            <!-- No divider/border on the right: a selected device row bleeds to this edge to merge with the right panel -->
            <Border Grid.Column="0" Background="#EFEFEF" BorderThickness="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header band shares the tab strip's gray so both columns form one continuous top band -->
                    <Border Grid.Row="0" Background="#EFEFEF">
                        <TextBlock Text="Devices" FontSize="14" FontWeight="Bold" Foreground="#333333"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,23,0,0" ClipToBounds="False">
                        <TextBlock Name="NoConnectedDevicesText" Text="No devices connected" Foreground="#999" FontSize="13"
                                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="15,0,15,0"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Name="ConnectedDevicesPanel" Visibility="Collapsed" HorizontalAlignment="Stretch"/>
                        </ScrollViewer>
                    </Grid>

                    <Button Grid.Row="2" Name="AddDeviceBottomButton" Content="Add Device"
                            Style="{StaticResource RoundedRectButtonStyle}" Padding="16,10" Background="#4CAF50"
                            FontSize="12" Margin="15,15,15,6" HorizontalAlignment="Stretch"
                            Click="AddDevice_Click"/>

                        <Button Grid.Row="3" Name="RemoveSelectedDeviceButton" Content="Remove"
                            Style="{StaticResource RoundedRectButtonStyle}" Padding="16,10" Background="#F44336"
                                FontSize="12" Margin="15,0,15,3" HorizontalAlignment="Stretch"
                            Click="RemoveDevice_Click"/>
                </Grid>
            </Border>

            <!-- Right Settings Area: top tab strip visually merges with the content below -->
            <Grid Grid.Column="1" Background="#EFEFEF">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Tab Strip -->
                <Border Grid.Row="0" Height="46" Background="#EFEFEF" Padding="0,0,0,0">
                    <TabControl Name="LeftTabControl" TabStripPlacement="Top"
                                Style="{StaticResource HeaderOnlyTabControlStyle}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Margin="12,0,0,0"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Left">
                        <TabItem Header="Information" Background="#F8D7DA" Style="{StaticResource ModernTabItemStyle}">
                            <Grid/>
                        </TabItem>
                        <TabItem Header="Synchronization" Background="#D9EAF7" Style="{StaticResource ModernTabItemStyle}">
                            <Grid/>
                        </TabItem>
                        <TabItem Header="Clock Style" Background="#FFF0C2" Style="{StaticResource ModernTabItemStyle}">
                            <Grid/>
                        </TabItem>
                        <TabItem Header="System Settings" Background="#DDEEDB" Style="{StaticResource ModernTabItemStyle}">
                            <Grid/>
                        </TabItem>
                    </TabControl>
                </Border>

                <!-- Tab Content -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderThickness="0"
                    CornerRadius="12" ClipToBounds="True" Margin="0,0,3,3">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Device Info Tab Content: shows only the currently selected device's basic info -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Name="DeviceInfoPanel" Margin="0">
                        <TextBlock Name="NoSelectedDeviceText" Text="Select a device from the list on the left to view its details"
                                   Foreground="#999" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed"/>
                        <Border Name="SelectedDeviceInfoCard" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="20" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Ellipse Name="SelectedDeviceStatusDot" Width="12" Height="12" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Name="SelectedDeviceNameText" FontSize="20" FontWeight="SemiBold" Foreground="#333333" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Name="SelectedDeviceMethodText" FontSize="13" Foreground="#666666" Margin="0,0,0,10"/>
                                <TextBlock Name="SelectedDeviceInfoText" FontSize="13" Foreground="#666666" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Synchronization Panel -->
                    <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Name="SyncPanel" Margin="0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Name="SyncItemsPanel" Margin="0"/>
                        </ScrollViewer>

                        <!-- Screenshot Request Button -->
                        <Button Grid.Row="1" Name="RequestScreenshotButton"
                                Style="{StaticResource RoundedRectButtonStyle}"
                            HorizontalAlignment="Center" Margin="0,15,0,0" Padding="14,8" Background="#4CAF50"
                                ToolTip="Request a screenshot from the device"
                                Click="RequestScreenshot_Click">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="pack://application:,,,/Resources/camera.png"
                                       Width="24" Height="24" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="Request Screenshot" VerticalAlignment="Center"
                                           Margin="8,0,0,0" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Settings Panel -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Name="SettingsPanel" Margin="0" Visibility="Collapsed">
                        <TextBlock Text="System Settings" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,15">
                            <StackPanel Margin="15">
                                <StackPanel Margin="0,0,0,15">
                                    <TextBlock Text="Communication Method:" FontWeight="Bold" Foreground="#333"/>
                                    <ComboBox Margin="0,8,0,0" Padding="10,8">
                                        <ComboBoxItem>COM Serial Port</ComboBoxItem>
                                        <ComboBoxItem>Bluetooth (BLE)</ComboBoxItem>
                                        <ComboBoxItem>Bluetooth (Classic)</ComboBoxItem>
                                        <ComboBoxItem>MQTT Ethernet</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,15">
                                    <TextBlock Text="Baud Rate:" FontWeight="Bold" Foreground="#333"/>
                                    <ComboBox Margin="0,8,0,0" Padding="10,8">
                                        <ComboBoxItem>9600</ComboBoxItem>
                                        <ComboBoxItem>19200</ComboBoxItem>
                                        <ComboBoxItem>115200</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel>
                                    <CheckBox Content="Auto-connect on startup" Margin="0,5,0,5"/>
                                    <CheckBox Content="Enable logging" Margin="0,5,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Clock Style Panel -->
                    <ScrollViewer Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Name="ClockStylePanel" Margin="0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <Style TargetType="{x:Type ScrollBar}">
                                <Setter Property="Width" Value="14"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                                            <Grid Background="Transparent">
                                                <Track x:Name="PART_Track"
                                                       Orientation="{TemplateBinding Orientation}"
                                                       IsDirectionReversed="True">
                                                    <Track.DecreaseRepeatButton>
                                                        <RepeatButton Command="ScrollBar.LineUpCommand"
                                                                      Background="Transparent"
                                                                      BorderThickness="0"
                                                                      IsTabStop="False"
                                                                      Focusable="False"/>
                                                    </Track.DecreaseRepeatButton>
                                                    <Track.Thumb>
                                                        <Thumb Margin="2,0"
                                                               Background="#9E9E9E"
                                                               BorderThickness="0">
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            CornerRadius="6"/>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Track.Thumb>
                                                    <Track.IncreaseRepeatButton>
                                                        <RepeatButton Command="ScrollBar.LineDownCommand"
                                                                      Background="Transparent"
                                                                      BorderThickness="0"
                                                                      IsTabStop="False"
                                                                      Focusable="False"/>
                                                    </Track.IncreaseRepeatButton>
                                                </Track>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ScrollViewer.Resources>
                        <StackPanel>
                        <TextBlock Text="Font" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,20">
                            <StackPanel Margin="15">
                                <!-- Font Selection -->
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Font" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" Name="ClockFontCombo" SelectedIndex="1"
                                              Style="{StaticResource RoundedRectComboBoxStyle}" Width="200" Height="32" FontSize="12"
                                              SelectionChanged="ClockFontCombo_SelectionChanged">
                                        <ComboBoxItem Content="Normal"/>
                                        <ComboBoxItem Content="Bold"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Font Color -->
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Font Color" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Name="ClockFontColorSwatch" Width="28" Height="28" CornerRadius="6"
                                                Background="#FFFFFF" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,10,0"/>
                                        <Button Name="ClockFontColorButton" Content="Pick Color"
                                                Style="{StaticResource RoundedRectButtonStyle}" Padding="16,8" FontSize="12"
                                                Click="ClockFontColor_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Clock X Position -->
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="X Position" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center" Width="90"/>
                                    <Slider Grid.Column="1" Name="ClockXSlider" Minimum="0" Maximum="31" Value="0"
                                            IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                            Margin="10,0,10,0" ValueChanged="ClockXSlider_ValueChanged"/>
                                    <TextBlock Grid.Column="2" Name="ClockXText" Text="0" Foreground="#333"
                                               VerticalAlignment="Center" MinWidth="22" TextAlignment="Right"/>
                                </Grid>

                                <!-- Clock Y Position -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Y Position" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center" Width="90"/>
                                    <Slider Grid.Column="1" Name="ClockYSlider" Minimum="0" Maximum="31" Value="0"
                                            IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                            Margin="10,0,10,0" ValueChanged="ClockYSlider_ValueChanged"/>
                                    <TextBlock Grid.Column="2" Name="ClockYText" Text="0" Foreground="#333"
                                               VerticalAlignment="Center" MinWidth="22" TextAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Background -->
                        <TextBlock Text="Background" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,15">
                            <StackPanel Margin="15">
                                <TextBlock Text="Default Mode" FontWeight="Bold" Foreground="#333" Margin="0,0,0,12"/>
                                <WrapPanel Name="ClockBackgroundModePanel" Orientation="Horizontal">
                                    <!-- Matrix -->
                                    <Border Name="ClockModeMatrix" Tag="Matrix" Margin="0,0,15,15"
                                            BorderBrush="#E0E0E0" BorderThickness="2" CornerRadius="8" Cursor="Hand"
                                            MouseLeftButtonUp="ClockBackgroundMode_Click">
                                        <StackPanel Margin="8">
                                            <Image Source="pack://application:,,,/Resources/Matrix.png"
                                                   Width="128" Height="128" Stretch="Uniform"/>
                                            <TextBlock Text="Matrix" HorizontalAlignment="Center" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="#333" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- GravityBall -->
                                    <Border Name="ClockModeGravityBall" Tag="GravityBall" Margin="0,0,15,15"
                                            BorderBrush="#E0E0E0" BorderThickness="2" CornerRadius="8" Cursor="Hand"
                                            MouseLeftButtonUp="ClockBackgroundMode_Click">
                                        <StackPanel Margin="8">
                                            <Image Source="pack://application:,,,/Resources/GravityBall.png"
                                                   Width="128" Height="128" Stretch="Uniform"/>
                                            <TextBlock Text="GravityBall" HorizontalAlignment="Center" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="#333" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Music -->
                                    <Border Name="ClockModeMusic" Tag="Music" Margin="0,0,15,15"
                                            BorderBrush="#E0E0E0" BorderThickness="2" CornerRadius="8" Cursor="Hand"
                                            MouseLeftButtonUp="ClockBackgroundMode_Click">
                                        <StackPanel Margin="8">
                                            <Image Source="pack://application:,,,/Resources/Music.png"
                                                   Width="128" Height="128" Stretch="Uniform"/>
                                            <TextBlock Text="Music" HorizontalAlignment="Center" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="#333" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>

                                <!-- Picture Mode -->
                                <TextBlock Text="Picture Mode" FontWeight="Bold" Foreground="#333" Margin="0,25,0,12"/>
                                <TextBlock Name="ClockPictureModeEmptyText" Text="No images found in ClockBackground folder"
                                           Foreground="#999" FontSize="12" Visibility="Collapsed" Margin="0,0,0,8"/>
                                <WrapPanel Name="ClockPictureModePanel" Orientation="Horizontal"/>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Apply Button (Clock Style tab) -->
                    <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Name="ClockApplyButton" Content="Apply"
                              Style="{StaticResource RoundedRectButtonStyle}" Padding="20,12" Background="#4CAF50"
                              FontSize="12" Margin="0,15,0,0" Width="200" HorizontalAlignment="Center"
                              Visibility="Collapsed"
                           Click="ClockApply_Click"/>
                </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="1" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid Margin="20,12">
                <TextBlock Name="NoDeviceStatusText"
                           Text="No Device"
                           Foreground="#666"
                           FontSize="12"
                           VerticalAlignment="Center"/>
                <StackPanel Name="DeviceStatusGroupPanel"
                            Orientation="Horizontal"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
