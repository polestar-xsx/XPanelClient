<Window x:Class="XPanel.Application.AddDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Device" Height="500" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#F8F9FA"
        ResizeMode="NoResize">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Add New Device" FontSize="16" FontWeight="Bold" Margin="0,0,0,20" Foreground="#333"/>

        <!-- Connection Method Selection -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Connection Method:" FontWeight="Bold" VerticalAlignment="Center" Foreground="#333"/>
            <ComboBox Grid.Column="1" Name="ConnectionMethodCombo" 
                     Margin="15,0,0,0" Padding="10,8"
                     SelectionChanged="ConnectionMethod_Changed">
                <ComboBoxItem Content="Bluetooth (BLE)" Tag="BLE"/>
                <ComboBoxItem Content="Serial Port (COM)" Tag="SerialPort"/>
                <ComboBoxItem Content="MQTT (Ethernet)" Tag="MQTT"/>
            </ComboBox>
        </Grid>

        <!-- Device List -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Name="DeviceListLabel" Text="Available Bluetooth Devices:" FontWeight="Bold" Margin="0,0,0,10" Foreground="#333"/>
            <ListBox Grid.Row="1" Name="AvailableDevicesList" 
                    Background="#FFFFFF" BorderBrush="#E0E0E0" Margin="0">
                <!-- Devices will be populated here -->
            </ListBox>
        </Grid>

        <!-- Buttons -->
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

                 <Button Grid.Column="1" Name="ConnectButton" Content="Connect" Padding="20,10" Background="#2196F3" Foreground="White" 
                   FontSize="12" Cursor="Hand" Margin="0,0,10,0"
                   Click="Connect_Click"/>
            <Button Grid.Column="2" Content="Cancel" Padding="20,10" Background="#999999" Foreground="White" 
                   FontSize="12" Cursor="Hand"
                   Click="Cancel_Click"/>
        </Grid>
    </Grid>
</Window>
