<Window x:Class="XPanel.Application.CopilotUsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Copilot Credits Login" Width="1080" Height="760"
        MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7F8"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#187A45" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Foreground" Value="#27343A" />
            <Setter Property="Background" Value="#E6EBED" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D9E0E3" BorderThickness="0,0,0,1" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GitHub Copilot Usage" FontSize="18" FontWeight="SemiBold" Foreground="#20292E" />
                    <TextBlock x:Name="StatusText" Text="Opening GitHub usage page…" Margin="0,4,0,0" Foreground="#69777D" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Open Usage Page" Style="{StaticResource ActionButtonStyle}" Click="OpenUsagePage_Click" />
                    <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Margin="0" Click="Cancel_Click" />
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#D9E0E3" BorderThickness="0,1,0,0" Padding="14,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Detected:" FontWeight="SemiBold" Foreground="#3C4A50" />
                <TextBlock x:Name="UsageText" Text="No usage read yet" Margin="8,0,18,0" Foreground="#173D62" />
                <TextBlock x:Name="ResetText" Foreground="#69777D" />
            </StackPanel>
        </Border>
        <wv2:WebView2 x:Name="Browser" />
    </DockPanel>
</Window>
